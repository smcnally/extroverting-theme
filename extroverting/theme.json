{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "720px",
			"wideSize": "1080px"
		},
		"color": {
			"defaultPalette": false,
			"palette": [
				{ "slug": "ink", "name": "Ink (deep pine)", "color": "#16241d" },
				{ "slug": "ink-2", "name": "Ink raised", "color": "#22382e" },
				{ "slug": "ink-3", "name": "Ink border", "color": "#2f4a3c" },
				{ "slug": "paper", "name": "Paper (green-tinted bone)", "color": "#f4f5ef" },
				{ "slug": "card", "name": "Card", "color": "#ffffff" },
				{ "slug": "marigold", "name": "Marigold (accent)", "color": "#efa61b" },
				{ "slug": "marigold-deep", "name": "Marigold deep", "color": "#c9820a" },
				{ "slug": "marigold-soft", "name": "Marigold soft", "color": "#fbe7bf" },
				{ "slug": "teal", "name": "Teal (secondary)", "color": "#2e6d5c" },
				{ "slug": "teal-soft", "name": "Teal soft", "color": "#dbe9e3" },
				{ "slug": "line", "name": "Hairline", "color": "#d9dccf" },
				{ "slug": "line-dark", "name": "Hairline dark", "color": "#3a5446" },
				{ "slug": "text", "name": "Text", "color": "#1b241f" },
				{ "slug": "muted", "name": "Muted", "color": "#5c665e" },
				{ "slug": "muted-2", "name": "Muted 2", "color": "#8a938b" },
				{ "slug": "danger", "name": "Danger", "color": "#b23b2e" },
				{ "slug": "danger-soft", "name": "Danger soft", "color": "#f3ddd9" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "on-dark", "name": "On dark", "color": "#cdd6cd" }
			],
			"gradients": [
				{ "slug": "hero", "name": "Hero", "gradient": "linear-gradient(135deg, #22382e 0%, #2e6d5c 100%)" },
				{ "slug": "hero-2", "name": "Hero (venue map)", "gradient": "linear-gradient(135deg, #dbe9e3 0%, #cfe0d8 100%)" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "archivo",
					"name": "Archivo",
					"fontFamily": "\"Archivo\", system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Archivo",
							"fontStyle": "normal",
							"fontWeight": "450",
							"src": [ "url('https://fonts.bunny.net/css?family=archivo:450,600,700,800,900') format('css') " ]
						}
					]
				}
			],
			"fluid": true,
			"fluidSizes": [
				{ "slug": "small", "name": "Small", "size": "14px", "fluid": true },
				{ "slug": "body", "name": "Body", "size": "16px", "fluid": true },
				{ "slug": "medium", "name": "Medium", "size": "20px", "fluid": true },
				{ "slug": "large", "name": "Large", "size": "28px", "fluid": true },
				{ "slug": "x-large", "name": "XL", "size": "42px", "fluid": true },
				{ "slug": "xx-large", "name": "XXL", "size": "52px", "fluid": true }
			]
		},
		"spacing": {
			"spacingSizes": [
				{ "slug": "10", "size": "clamp(10px, 0.8rem, 12px)" },
				{ "slug": "20", "size": "clamp(16px, 1.2rem, 20px)" },
				{ "slug": "30", "size": "clamp(24px, 1.8rem, 32px)" },
				{ "slug": "40", "size": "clamp(32px, 2.4rem, 48px)" },
				{ "slug": "50", "size": "clamp(48px, 3.6rem, 64px)" }
			],
			"units": [ "px", "em", "rem", "vh", "vw", "%" ]
		},
		"border": {
			"radius": [
				{ "slug": "small", "name": "Small", "radius": "8px" },
				{ "slug": "medium", "name": "Medium", "radius": "14px" },
				{ "slug": "large", "name": "Large", "radius": "22px" },
				{ "slug": "pill", "name": "Pill", "radius": "999px" }
			],
			"color": true,
			"width": true
		},
		"shadow": {
			"presets": [
				{ "slug": "1", "name": "Shadow 1", "shadow": "0 1px 2px rgba(20,36,29,.06), 0 6px 18px rgba(20,36,29,.07)" },
				{ "slug": "2", "name": "Shadow 2", "shadow": "0 12px 40px rgba(20,36,29,.20)" }
			]
		},
		"custom": {
			"tap": "48px"
		}
	},
	"styles": {
		"fontFamily": "archivo",
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--text)"
		},
		"typography": {
			"fontSize": "var(--wp--preset--font-size--body)",
			"lineHeight": "1.5",
			"fontWeight": "450"
		},
		"elements": {
			"heading": {
				"typography": { "fontWeight": "800", "lineHeight": "1.05", "letterSpacing": "-.01em" },
				"color": { "text": "var(--wp--preset--color--text)" }
			},
			"h1": { "typography": { "fontWeight": "900", "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-.03em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"link": { "color": { "text": "var(--wp--preset--color--teal)" } },
			"button": {
				"border": { "radius": "8px" },
				"color": { "background": "var(--wp--preset--color--marigold)", "text": "#241a02" },
				"typography": { "fontWeight": "700" },
				"spacing": { "padding": { "top": "0", "right": "18px", "bottom": "0", "left": "18px" } }
			},
			"caption": { "color": { "text": "var(--wp--preset--color--muted)" } }
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontWeight": "900", "fontSize": "23px", "letterSpacing": "-.03em" },
				"color": { "text": "#fff" }
			},
			"core/separator": { "border": { "color": "var(--wp--preset--color--line)" } },
			"core/post-title": { "typography": { "fontWeight": "900" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
